{
  "expo": {
    "name": "VICAST",
    "slug": "vicast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vicast",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["es"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "VICAST · Levantamientos",
      "shortName": "VICAST"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VICAST necesita acceder a tus fotos para adjuntar evidencia al levantamiento.",
          "cameraPermission": "VICAST necesita la cámara para fotografiar las superficies en terreno.",
          "microphonePermission": false
        }
      ]
    ],
    "locales": {
      "es": "./locales/es.json"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
